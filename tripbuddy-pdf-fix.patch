diff --git a/static/style.css b/static/style.css
index 9214c5f..07c6b8d 100644
--- a/static/style.css
+++ b/static/style.css
@@ -631,3 +631,189 @@ footer {
     grid-template-columns: 1fr;
   }
 }
+
+/* PDF export (static/pdf_export.js): a white, A4-width copy of the plan.
+   It is built off-screen, turned into the PDF, then removed. */
+.pdf-host {
+  position: fixed;
+  left: -10000px;
+  top: 0;
+  z-index: -1;
+}
+
+.pdf-sheet {
+  background: #ffffff;
+  color: #1f2937;
+  font-family: Inter, "Segoe UI", system-ui, -apple-system, sans-serif;
+  font-size: 12.5px;
+  line-height: 1.55;
+  /* A tiny letter-spacing makes html2canvas place every character exactly where the
+     browser laid it out; without it, wrapped text near quotes and brackets can overprint. */
+  letter-spacing: 0.01px;
+}
+
+/* Headings often start with emoji like 1️⃣, which per-character placement would break,
+   and they rarely wrap, so they keep normal spacing. */
+.pdf-header,
+.pdf-body h1,
+.pdf-body h2,
+.pdf-body h3,
+.pdf-body h4 {
+  letter-spacing: normal;
+}
+
+.pdf-header {
+  padding-bottom: 10px;
+  margin-bottom: 14px;
+  border-bottom: 2px solid #2563eb;
+}
+
+.pdf-brand {
+  color: #2563eb;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.pdf-doc-title {
+  margin-top: 2px;
+  color: #0f172a;
+  font-size: 22px;
+  line-height: 1.25;
+}
+
+.pdf-doc-subtitle {
+  margin-top: 3px;
+  color: #64748b;
+  font-size: 10.5px;
+}
+
+.pdf-body > :first-child {
+  margin-top: 0;
+}
+
+.pdf-body h1,
+.pdf-body h2,
+.pdf-body h3,
+.pdf-body h4 {
+  color: #0f172a;
+  line-height: 1.3;
+}
+
+.pdf-body h1 {
+  margin: 16px 0 8px;
+  font-size: 17px;
+}
+
+.pdf-body h2 {
+  margin: 18px 0 8px;
+  padding: 6px 10px;
+  border-left: 4px solid #2563eb;
+  border-radius: 4px;
+  background: #eff6ff;
+  font-size: 15px;
+}
+
+.pdf-body h3 {
+  margin: 14px 0 6px;
+  color: #1d4ed8;
+  font-size: 13.5px;
+}
+
+.pdf-body h4 {
+  margin: 12px 0 4px;
+  font-size: 11.5px;
+}
+
+.pdf-body p {
+  margin: 0 0 8px;
+}
+
+.pdf-body ul,
+.pdf-body ol {
+  margin: 4px 0 10px 4px;
+  list-style: none; /* markers are added as text by pdf_export.js */
+}
+
+.pdf-body li {
+  position: relative;
+  margin-bottom: 3px;
+  padding-left: 16px;
+}
+
+.pdf-body ol > li {
+  padding-left: 22px;
+}
+
+.pdf-marker {
+  position: absolute;
+  left: 2px;
+  top: 0;
+  color: #2563eb;
+  letter-spacing: normal;
+}
+
+.pdf-marker.number {
+  left: 0;
+  color: #0f172a;
+  font-weight: 700;
+}
+
+.pdf-body strong {
+  color: #0f172a;
+}
+
+.pdf-body a {
+  color: #1d4ed8;
+  text-decoration: none;
+}
+
+.pdf-body hr {
+  margin: 12px 0;
+  border: none;
+  border-top: 1px solid #e5e7eb;
+}
+
+.pdf-body blockquote {
+  margin: 8px 0;
+  padding-left: 10px;
+  border-left: 3px solid #cbd5e1;
+  color: #475569;
+}
+
+.pdf-body pre,
+.pdf-body code {
+  font-family: Consolas, "Courier New", monospace;
+  font-size: 9.5px;
+  white-space: pre-wrap;
+}
+
+.pdf-body table {
+  width: 100%;
+  margin: 8px 0 12px;
+  border-collapse: collapse;
+  font-size: 10.5px;
+  line-height: 1.4;
+}
+
+.pdf-body th,
+.pdf-body td {
+  padding: 4px 5px;
+  border: 1px solid #dbe3ee;
+  text-align: left;
+  vertical-align: top;
+  overflow-wrap: break-word; /* long words wrap instead of spilling over (html2canvas ignores "anywhere") */
+}
+
+.pdf-body th {
+  background: #eff6ff;
+  color: #0f172a;
+  font-weight: 700;
+}
+
+.pdf-body tr.pdf-spacer td {
+  padding: 0;
+  border: none;
+  background: transparent;
+}
